	DynamicLoadObject(CustomizedAnnouncerPack$".AnnouncerTeamParcelworkersScore", class'Sound');
	DynamicLoadObject(CustomizedAnnouncerPack$".AnnouncerTeamParcelworkersWin", class'Sound');
