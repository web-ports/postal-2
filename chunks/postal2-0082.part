function BloodSpoutCheckboxChanged()
	{
	local int val;

	if (bUpdate)
		{
		if (BloodSpoutCheckbox.bChecked)
			val = 1;
		GetPlayerOwner().ConsoleCommand("set" @ BloodSpoutCheckboxPath @ val);
		}
	}
