///////////////////////////////////////////////////////////////////////////////
// Handle notifications from controls
///////////////////////////////////////////////////////////////////////////////
function Notify(UWindowDialogControl C, byte E)
	{
	local ShellMenuCW		mnuNext;

	Super.Notify(C, E);
	switch (E)
		{
		case DE_Change:
			switch (C)
				{
				}
			break;
		case DE_Click:
