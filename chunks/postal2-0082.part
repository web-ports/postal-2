	{
		if(statecount < CurrentFloat)
		{
			statecount++;
			GotoState(GetStateName(), 'Begin');
		}
		else
			GotoNextState();
	}

	///////////////////////////////////////////////////////////////////////////////
	///////////////////////////////////////////////////////////////////////////////
	function BeginState()
	{
		Super.BeginState();
		statecount = 0;
	}
}

