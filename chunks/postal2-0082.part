///////////////////////////////////////////////////////////////////////////////
// True if this pawn is the postal dude masquerading as a cop
///////////////////////////////////////////////////////////////////////////////
function bool DudeDressedAsDude(FPSPawn CheckP)
{
	local P2Player p2p;

	if(CheckP != None)
	{
		p2p = P2Player(CheckP.Controller);
		if(p2p != None 
		   && p2p.DudeIsDude())
			return true;
	}

	return false;
}

