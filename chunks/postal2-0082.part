// SteamEmitter. 
//
// For putting out fires.
///////////////////////////////////////////////////////////////////////////////
class SteamEmitter extends TimedEmitter;

var Sound SteamSound;


///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
auto state Steaming
{
Begin:
	PlaySound(SteamSound,,1.0,,1.0);
	Sleep(GetSoundDuration(SteamSound));
	Goto('Begin');
}

