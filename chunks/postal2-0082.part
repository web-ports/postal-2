		BalancePlayersCheck.SetHelpText(BalancePlayersHelp);
		BalancePlayersCheck.SetFont(ControlFont);
		BalancePlayersCheck.bChecked = Class<TeamGame>(BotmatchParent.GameClass).Default.bPlayersBalanceTeams;
