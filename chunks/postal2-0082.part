6•6Ÿ␀‰␀‘6’6Ÿ␀‰␀‘¥␀␀␀&Å–␀7‰»w␀‰*¸6’6œ␀‰␀‘}¹6•6œ␀‰␀‘}¸6’6¡␀‰␀‘}¹6•6¡␀‰␀‘}¸6’6Ÿ␀‰␀‘}¹6•6Ÿ␀‰␀‘}¥␀¼␀␀␀␀␀Q␀E	␀␀␀€␀␀␀Q†Q␀␀␀␀␀␀␀␀V///////////////////////////////////////////////////////////////////////////////
// ChemPillar
// 
// Pillar of chemical gas
//
///////////////////////////////////////////////////////////////////////////////
class ChemPillar extends P2Emitter;

var bool bStopped;

const MOVE_TIME	=	0.3;

///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
// Active
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////
auto state Active
{
	simulated function ProcessTouch(Actor Other, Vector HitLocation)
	{
		Stopping();
	}
	simulated function HitWall (vector HitNormal, actor Wall)
	{
		Stopping();
	}

	///////////////////////////////////////////////////////////////////////////////
	// Stop the pillar, but also make the top ball
	///////////////////////////////////////////////////////////////////////////////
	function Stopping()
	{
		local FireBall fp;
		if(!bStopped)
		{
			bStopped=true;
			Velocity.Z=0;
			// Top chemball
			spawn(class'ChemBall',,,Location);
		}
	}
Begin:
	Sleep(MOVE_TIME);
	Stopping();
}

