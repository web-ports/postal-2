;
; Server list title tabs
;
[ServerListTitles]
UBrowserLAN=LAN
UBrowserPostal2=All
UBrowserDeathmatch=DM
UBrowserTeamGames=Team DM
UBrowserCTF=Snatch
UBrowserGrabBag=Grab
UBrowserAll=AllHidden

[ServerListPageHeaders]
UBrowserLAN=Shows all the games you can join on your Local Area Network
UBrowserPostal2=Shows all the games you can join on the Internet
UBrowserDeathmatch=Shows just the 'DeathMatch' games you can join on the Internet
UBrowserTeamGames=Shows just the 'Team DeathMatch' games you can join on the Internet
UBrowserCTF=Shows just the 'Snatch' games you can join on the Internet
UBrowserGrabBag=Shows just the 'Grab' games you can join on the Internet
UBrowserAll=AllHidden
UTBrowserFavoriteServers=Shows your favorites.  You can add to favorites from the other tabs.
[MpGary]
MenuName=Gary Coleman

[MpDude]
MenuName=Postal Dude

[MutInstaKill]
FriendlyName=Instant Kill
Description=Causes instant death by any weapon, explosion or fire.

[MutLowGrav]
FriendlyName=Low Gravity
Description=Turns on low gravity so you can jump real high.  Kind of fun in a gay sort of way.  Also lets you get to all sorts of places you shouldn't get to, so don't complain when you fall out of the world.

[MutGBDoubleStrength]
FriendlyName=Grab: Double Strength
Description=For GrabBag games only--doubles the strength you get with each bag you pick up.

[MutAlwaysGib]
FriendlyName=Always Gib
Description=Instead of normal deaths, everyone always explodes into gibs when they die.

