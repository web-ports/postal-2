WindowTitle=Configure Mutators

[UMenuMapListWindow]
WindowTitle=Map List

[UMenuStartGameWindow]
WindowTitle=Host Multiplayer Game

[UMenuBotmatchWindow]
WindowTitle=Botmatch

[UTCTFSettingsCWindow]
FragText=Capture Limit

[ngWorldSecretWindow]
WindowTitle=Game Stats Password

[UTBrowserMainWindow]
WindowTitleString=Join Multiplayer Game

