;
; Game types
;
Object=(Name=MultiGame.xDeathMatch,Class=Class,MetaClass=MultiBase.MpGameInfo)
Object=(Name=MultiGame.xTeamGame,Class=Class,MetaClass=MultiBase.MpGameInfo)
Object=(Name=MultiGame.xCTFGame,Class=Class,MetaClass=MultiBase.MpGameInfo)
Object=(Name=MultiGame.xGrabBag,Class=Class,MetaClass=MultiBase.MpGameInfo)
;
; Mutators
;
Object=(Name=MultiStuff.MutInstaKill,Class=Class,MetaClass=Engine.Mutator,Description="Instakill")
Object=(Name=MultiStuff.MutAlwaysGib,Class=Class,MetaClass=Engine.Mutator,Description="AlwaysGib")
Object=(Name=MultiStuff.MutLowGrav,Class=Class,MetaClass=Engine.Mutator,Description="LowGravity")
Object=(Name=MultiGame.MutNoCrack,Class=Class,MetaClass=Engine.Mutator,Description="NoCrack")
Object=(Name=MultiGame.MutNoSavedHealth,Class=Class,MetaClass=Engine.Mutator,Description="NoSavedHealth")
Object=(Name=MultiGame.MutCTFNoTouchReturns,Class=Class,MetaClass=Engine.Mutator,Description="CTFNoTouchReturns")
Object=(Name=MultiStuff.MutGBDoubleStrength,Class=Class,MetaClass=Engine.Mutator,Description="GBDoubleStrength")
;
; Teams
; List grudge teams in description, separated by commas (they don't have to be mutual, one-way is enough)
;
Object=(Name=MultiGame.xDMRoster,Class=Class,MetaClass=MultiBase.MpTeamInfo,Description="DefaultDM")
Object=(Name=MultiGame.TeamBand,Class=Class,MetaClass=MultiBase.MpTeamInfo,Description="MultiGame.TeamDude")
Object=(Name=MultiGame.TeamButchers,Class=Class,MetaClass=MultiBase.MpTeamInfo)
Object=(Name=MultiGame.TeamCops,Class=Class,MetaClass=MultiBase.MpTeamInfo, Description="MultiGame.TeamGary,MultiGame.TeamRobbers")
Object=(Name=MultiGame.TeamDude,Class=Class,MetaClass=MultiBase.MpTeamInfo)
Object=(Name=MultiGame.TeamFanatics,Class=Class,MetaClass=MultiBase.MpTeamInfo)
