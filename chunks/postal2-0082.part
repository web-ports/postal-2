///////////////////////////////////////////////////////////////////////////////
// Player wants to look at map, make sure it's okay to do it now.
///////////////////////////////////////////////////////////////////////////////
function RequestMap()
	{
	// Only do this for single player games
	if (P2GameInfoSingle(Level.Game) != None)
		{

