			&& P2Weapon(CreatorPawn.Weapon) != None
			&& P2Weapon(CreatorPawn.Weapon).ViolenceRank > 1
			&& AllowTalking())
			MyPawn.Say(MyPawn.myDialog.lDude_FirstSeenWithWeapon);
		WeaponFirstTimeFireInstance=FIRE_ENDED;
	}
}

