function FFChanged()
{
	Class<TeamGame>(BotmatchParent.GameClass).Default.FriendlyFireScale = FFSlider.GetValue() / 10;
	FFSlider.SetText(FFText$" ("$int(FFSlider.GetValue()*10)$"%)");
}

