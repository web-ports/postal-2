	Class<TeamGame>(BotmatchParent.GameClass).Default.MaxTeams = int(MaxTeamsEdit.GetValue());
}

function TeamScoreChanged()
{
	Class<TeamGame>(BotmatchParent.GameClass).Default.GoalTeamScore = int(TeamScoreEdit.GetValue());
}
