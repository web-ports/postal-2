		MaxPlayersEdit.SetHelpText(MaxPlayersHelp);
		MaxPlayersEdit.SetFont(F_SmallBold);
		MaxPlayersEdit.SetNumericOnly(True);
		MaxPlayersEdit.SetMaxLength(2);
