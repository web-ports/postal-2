		&& FPSGameInfo(Level.Game).bIsSinglePlayer)
		return ((StopFiringTime > Level.TimeSeconds) || bForce 
		//|| Instigator.PressingFire()
		);
	else
		return ((StopFiringTime > Level.TimeSeconds) || bForce 
		//|| Instigator.PressingFire()
		);
}

