	//log("hit normal "$HitNormal);
	LastHitLocation = GroundHit;
	HandleStarter(GroundHit, HitNormal, HitVel, DeltaTime);
	HandlePuddle(GroundHit, HitNormal, DeltaTime);
	HandleTrail(GroundHit, HitNormal);

	
