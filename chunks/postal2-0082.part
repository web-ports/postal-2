///////////////////////////////////////////////////////////////////////////////
// Set speed based on current health
///////////////////////////////////////////////////////////////////////////////
function SetHeartBeatBasedOnHealth()
{
	local float pct;

	pct = 1.0 - (MyPawn.Health/MyPawn.HealthMax);
	// cap percentage
	if(pct < 0.0)
		pct=0.0;
	// heart stuff
	HeartBeatSpeed = HeartBeatSpeedAdd*pct + default.HeartBeatSpeed;
}

